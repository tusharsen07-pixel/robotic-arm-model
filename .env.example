# ============================================================
# AI Robotic Arm — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Serial Communication (ESP32) ---
ESP32_PORT=COM3          # Windows: COMx  |  Linux/Pi: /dev/ttyUSB0
ESP32_BAUD=115200

# --- Camera ---
CAMERA_INDEX=0           # USB camera index (usually 0)

# --- Logging ---
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- Simulation ---
SIMULATION_MODE=true     # Set to false when real hardware is connected
